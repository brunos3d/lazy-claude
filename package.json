{
  "name": "lazy-claude",
  "version": "1.0.0",
  "description": "Find, resume and manage Claude Code sessions from the terminal: a LazyGit-style TUI plus a full CLI",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunos3d/lazy-claude.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-sessions",
    "tui",
    "cli",
    "terminal",
    "session-manager",
    "resume",
    "lazygit",
    "fuzzy-search",
    "ink"
  ],
  "bin": {
    "lazy-claude": "dist/cli.js",
    "lazyclaude": "dist/cli.js",
    "lzc": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/chmod-bin.mjs",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
